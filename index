<!DOCTYPE html>
 
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ágape — Conciencia · Ciencia · Bienestar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500&family=Allura&display=swap" rel="stylesheet">
<style>
  :root {
    --azul: #8DA9C4;
    --azul-medio: #6B8AAB;
    --azul-dark: #4A6B85;
    --azul-deep: #2E4B66;
    --dorado: #C9A66B;
    --dorado-claro: #E0C896;
    --arena: #F2E9E4;
    --arena-suave: #F8F2EE;
    --hueso: #FAF9F6;
    --crema: #FBF8F3;
    --texto: #4A4A45;
    --texto-suave: #8A8A85;
    --linea: rgba(141, 169, 196, 0.25);
  }

- { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }

body {
font-family: ‘Inter’, sans-serif;
background: var(–hueso);
color: var(–texto);
line-height: 1.7;
font-weight: 300;
overflow-x: hidden;
}

.serif { font-family: ‘Cormorant Garamond’, serif; }
.script { font-family: ‘Allura’, cursive; }

/* ============ NAVEGACIÓN ============ */
nav {
position: fixed;
top: 0;
left: 0;
right: 0;
padding: 20px 60px;
background: rgba(250, 249, 246, 0.9);
backdrop-filter: blur(20px);
-webkit-backdrop-filter: blur(20px);
z-index: 100;
display: flex;
justify-content: space-between;
align-items: center;
border-bottom: 1px solid var(–linea);
}

.nav-logo {
font-family: ‘Cormorant Garamond’, serif;
font-size: 24px;
font-weight: 500;
color: var(–azul-deep);
letter-spacing: 4px;
}

.nav-links {
display: flex;
gap: 38px;
list-style: none;
}

.nav-links a {
text-decoration: none;
color: var(–texto);
font-size: 12px;
letter-spacing: 2px;
text-transform: uppercase;
transition: color 0.3s;
font-weight: 400;
}

.nav-links a:hover { color: var(–azul-dark); }

.nav-cta {
background: var(–azul-dark);
border: 1px solid var(–azul-dark);
color: var(–hueso);
padding: 11px 24px;
font-size: 11px;
letter-spacing: 2px;
text-transform: uppercase;
cursor: pointer;
transition: all 0.3s;
font-family: ‘Inter’, sans-serif;
font-weight: 400;
}

.nav-cta:hover {
background: var(–azul-deep);
border-color: var(–azul-deep);
}

/* ============ HERO ============ */
.hero {
min-height: 100vh;
padding: 140px 60px 80px;
background:
radial-gradient(ellipse at 80% 30%, rgba(201, 166, 107, 0.06) 0%, transparent 50%),
radial-gradient(ellipse at 15% 70%, rgba(141, 169, 196, 0.08) 0%, transparent 60%),
linear-gradient(180deg, var(–hueso) 0%, var(–crema) 100%);
position: relative;
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
text-align: center;
overflow: hidden;
}

/* Decoración hojas SVG en el fondo */
.hero-decoration {
position: absolute;
pointer-events: none;
opacity: 0.4;
}

.deco-left {
top: 100px;
left: -50px;
width: 280px;
transform: rotate(-15deg);
}

.deco-right {
bottom: 60px;
right: -40px;
width: 320px;
transform: rotate(165deg);
}

.hero-logo-mark {
width: 100px;
height: 100px;
margin-bottom: 24px;
opacity: 0;
animation: fadeUp 0.9s ease-out 0.1s forwards;
}

.hero-name {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(72px, 11vw, 140px);
font-weight: 400;
color: var(–azul-deep);
letter-spacing: 18px;
line-height: 1;
margin-bottom: 12px;
margin-left: 18px; /* compensa el letter-spacing */
opacity: 0;
animation: fadeUp 0.9s ease-out 0.3s forwards;
}

.hero-rule {
display: flex;
align-items: center;
gap: 18px;
margin-bottom: 18px;
opacity: 0;
animation: fadeUp 0.9s ease-out 0.5s forwards;
}

.hero-rule-line {
width: 60px;
height: 1px;
background: var(–dorado);
}

.hero-rule-icon {
width: 14px;
height: 14px;
color: var(–dorado);
}

.hero-tagline {
font-size: 13px;
letter-spacing: 8px;
text-transform: uppercase;
color: var(–azul-dark);
margin-bottom: 80px;
opacity: 0;
animation: fadeUp 0.9s ease-out 0.6s forwards;
}

.hero-quote {
max-width: 700px;
opacity: 0;
animation: fadeUp 0.9s ease-out 0.8s forwards;
}

.hero-quote-1 {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(36px, 5vw, 56px);
font-weight: 400;
color: var(–azul-deep);
line-height: 1.2;
margin-bottom: 4px;
}

.hero-quote-2 {
font-family: ‘Allura’, cursive;
font-size: clamp(48px, 7vw, 78px);
color: var(–azul-dark);
line-height: 1;
font-weight: 400;
}

.hero-cta-row {
margin-top: 60px;
display: flex;
gap: 24px;
justify-content: center;
align-items: center;
flex-wrap: wrap;
opacity: 0;
animation: fadeUp 0.9s ease-out 1s forwards;
}

.btn-primary {
background: var(–azul-dark);
color: var(–hueso);
border: none;
padding: 16px 38px;
font-size: 12px;
letter-spacing: 2.5px;
text-transform: uppercase;
cursor: pointer;
transition: all 0.3s;
font-family: ‘Inter’, sans-serif;
font-weight: 400;
}

.btn-primary:hover {
background: var(–azul-deep);
transform: translateY(-2px);
box-shadow: 0 10px 30px rgba(46, 75, 102, 0.2);
}

.btn-secondary {
background: transparent;
border: none;
color: var(–azul-dark);
font-size: 12px;
letter-spacing: 2px;
text-transform: uppercase;
cursor: pointer;
font-family: ‘Inter’, sans-serif;
display: flex;
align-items: center;
gap: 12px;
padding: 14px 0;
border-bottom: 1px solid var(–dorado);
transition: gap 0.3s;
}

.btn-secondary:hover { gap: 18px; }

/* ============ BLOQUE “ES UN ESPACIO” ============ */
.espacio {
padding: 120px 60px;
background: var(–hueso);
position: relative;
}

.espacio-grid {
max-width: 1200px;
margin: 0 auto;
display: grid;
grid-template-columns: 1.2fr 1fr;
gap: 60px;
align-items: center;
}

.espacio-titulo {
font-family: ‘Cormorant Garamond’, serif;
font-size: 32px;
font-weight: 400;
color: var(–azul-deep);
margin-bottom: 16px;
line-height: 1.3;
}

.espacio-subtitulo {
font-size: 17px;
color: var(–texto-suave);
margin-bottom: 50px;
}

.espacio-cards {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 28px;
}

.espacio-card {
text-align: center;
}

.espacio-card-icon {
width: 80px;
height: 80px;
margin: 0 auto 20px;
background: var(–arena);
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
transition: transform 0.4s;
}

.espacio-card:hover .espacio-card-icon {
transform: scale(1.05);
background: var(–arena-suave);
}

.espacio-card-icon svg {
width: 40px;
height: 40px;
color: var(–azul-dark);
}

.espacio-card-texto {
font-family: ‘Cormorant Garamond’, serif;
font-size: 18px;
color: var(–azul-deep);
line-height: 1.4;
font-style: italic;
font-weight: 400;
}

/* Tarjeta lateral azul */
.espacio-nombre {
background: linear-gradient(135deg, #7B98B8 0%, #5C7E9E 100%);
border-radius: 12px;
padding: 50px 40px;
color: var(–hueso);
position: relative;
overflow: hidden;
}

.espacio-nombre::before {
content: ‘’;
position: absolute;
top: -50px;
right: -50px;
width: 200px;
height: 200px;
background: radial-gradient(circle, rgba(212, 175, 127, 0.15) 0%, transparent 70%);
}

.espacio-nombre-icon {
width: 50px;
height: 50px;
margin-bottom: 24px;
color: var(–dorado-claro);
}

.espacio-nombre-titulo {
font-family: ‘Cormorant Garamond’, serif;
font-size: 22px;
font-weight: 500;
margin-bottom: 18px;
color: var(–hueso);
}

.espacio-nombre-texto {
font-size: 15px;
line-height: 1.8;
margin-bottom: 20px;
color: rgba(250, 249, 246, 0.92);
}

.espacio-nombre-destacado {
font-family: ‘Cormorant Garamond’, serif;
font-size: 19px;
font-weight: 500;
color: var(–dorado-claro);
line-height: 1.4;
margin-top: 16px;
}

/* ============ ESENCIA (3 pilares) ============ */
.esencia {
padding: 120px 60px;
background: linear-gradient(180deg, var(–hueso) 0%, var(–crema) 100%);
}

.section-eyebrow-rule {
display: flex;
align-items: center;
justify-content: center;
gap: 20px;
margin-bottom: 70px;
}

.eyebrow-line {
width: 60px;
height: 1px;
background: var(–dorado);
}

.eyebrow-text {
font-size: 12px;
letter-spacing: 6px;
text-transform: uppercase;
color: var(–azul-dark);
font-weight: 500;
}

.esencia-grid {
max-width: 1200px;
margin: 0 auto;
display: grid;
grid-template-columns: 1.4fr 1fr;
gap: 80px;
align-items: center;
}

.pilares {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 30px;
}

.pilar {
text-align: center;
}

.pilar-icon {
width: 90px;
height: 90px;
margin: 0 auto 20px;
background: var(–arena);
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
transition: all 0.4s;
}

.pilar:hover .pilar-icon {
transform: translateY(-4px);
box-shadow: 0 10px 25px rgba(141, 169, 196, 0.2);
}

.pilar-icon svg {
width: 44px;
height: 44px;
color: var(–azul-dark);
}

.pilar-titulo {
font-size: 13px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–azul-deep);
font-weight: 500;
margin-bottom: 14px;
}

.pilar-desc {
font-size: 14px;
line-height: 1.7;
color: var(–texto-suave);
}

.esencia-quote-box {
background: var(–arena);
border-radius: 12px;
padding: 50px 40px;
position: relative;
overflow: hidden;
}

.esencia-quote-box::before {
content: ‘’;
position: absolute;
top: -30px;
right: -30px;
width: 150px;
height: 150px;
background: radial-gradient(circle, rgba(201, 166, 107, 0.1) 0%, transparent 70%);
}

.esencia-quote-rama {
width: 60px;
height: 60px;
margin-bottom: 24px;
color: var(–azul);
opacity: 0.5;
}

.esencia-quote-text {
font-family: ‘Cormorant Garamond’, serif;
font-size: 22px;
line-height: 1.5;
color: var(–azul-deep);
font-style: italic;
font-weight: 400;
}

.esencia-quote-highlight {
color: var(–azul-dark);
font-weight: 500;
}

/* ============ SERVICIOS ============ */
.servicios {
padding: 120px 60px;
background: var(–crema);
}

.servicios-grid {
max-width: 1300px;
margin: 0 auto;
display: grid;
grid-template-columns: repeat(5, 1fr);
gap: 24px;
}

.servicio-card {
background: var(–hueso);
border-radius: 16px;
padding: 36px 26px;
text-align: center;
transition: all 0.4s;
cursor: pointer;
border: 1px solid transparent;
}

.servicio-card:hover {
transform: translateY(-6px);
border-color: var(–linea);
box-shadow: 0 15px 40px rgba(141, 169, 196, 0.12);
}

.servicio-icon {
width: 90px;
height: 90px;
margin: 0 auto 24px;
background: linear-gradient(135deg, var(–arena) 0%, var(–arena-suave) 100%);
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
position: relative;
}

.servicio-icon::before {
content: ‘’;
position: absolute;
top: -3px;
right: 4px;
width: 6px;
height: 6px;
background: var(–dorado);
border-radius: 50%;
}

.servicio-icon svg {
width: 44px;
height: 44px;
color: var(–azul-dark);
}

.servicio-titulo {
font-size: 12px;
letter-spacing: 2px;
text-transform: uppercase;
color: var(–azul-deep);
font-weight: 600;
margin-bottom: 14px;
line-height: 1.4;
min-height: 36px;
}

.servicio-desc {
font-size: 13px;
line-height: 1.7;
color: var(–texto-suave);
}

/* ============ AUTOR DE LA SEMANA ============ */
.autor {
padding: 120px 60px;
background: var(–hueso);
}

.autor-container {
max-width: 1200px;
margin: 0 auto;
display: grid;
grid-template-columns: 1fr 1.3fr;
gap: 70px;
align-items: center;
}

.autor-visual {
position: relative;
aspect-ratio: 4 / 5;
background: linear-gradient(135deg, var(–arena) 0%, var(–arena-suave) 100%);
border-radius: 16px;
overflow: hidden;
}

.autor-portrait {
width: 100%;
height: 100%;
display: flex;
align-items: center;
justify-content: center;
position: relative;
}

.autor-portrait svg {
width: 55%;
height: auto;
opacity: 0.85;
}

.autor-frame {
position: absolute;
top: 24px;
left: 24px;
right: 24px;
bottom: 24px;
border: 1px solid var(–dorado);
opacity: 0.5;
pointer-events: none;
border-radius: 8px;
}

.autor-meta {
position: absolute;
top: 30px;
left: 30px;
z-index: 3;
font-size: 10px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–azul-deep);
background: rgba(250, 249, 246, 0.92);
padding: 8px 14px;
backdrop-filter: blur(10px);
border-radius: 4px;
}

.autor-name {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(40px, 5vw, 60px);
font-weight: 400;
color: var(–azul-deep);
line-height: 1.05;
margin: 24px 0 8px;
letter-spacing: -0.5px;
}

.autor-dates {
font-family: ‘Cormorant Garamond’, serif;
font-style: italic;
font-size: 17px;
color: var(–texto-suave);
margin-bottom: 24px;
}

.autor-tema {
font-family: ‘Cormorant Garamond’, serif;
font-size: 22px;
font-style: italic;
color: var(–dorado);
margin-bottom: 30px;
line-height: 1.4;
}

.autor-atenea {
background: var(–arena);
padding: 28px 30px;
border-radius: 10px;
border-left: 3px solid var(–dorado);
margin-bottom: 30px;
}

.atenea-label {
font-size: 10px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–dorado);
margin-bottom: 14px;
display: flex;
align-items: center;
gap: 10px;
font-weight: 600;
}

.atenea-label::before {
content: ‘’;
width: 6px;
height: 6px;
background: var(–dorado);
border-radius: 50%;
}

.autor-atenea p {
font-family: ‘Cormorant Garamond’, serif;
font-size: 18px;
line-height: 1.6;
color: var(–azul-deep);
font-style: italic;
}

/* ============ MODALIDADES (banda azul) ============ */
.modalidades {
padding: 60px 60px;
background: var(–hueso);
}

.modalidades-banda {
max-width: 1200px;
margin: 0 auto;
background: linear-gradient(135deg, #7B98B8 0%, #5C7E9E 100%);
border-radius: 16px;
padding: 40px 50px;
display: grid;
grid-template-columns: auto 1fr 1fr 1fr;
gap: 50px;
align-items: center;
color: var(–hueso);
position: relative;
overflow: hidden;
}

.modalidades-banda::before {
content: ‘’;
position: absolute;
top: -100px;
right: -100px;
width: 280px;
height: 280px;
background: radial-gradient(circle, rgba(212, 175, 127, 0.12) 0%, transparent 70%);
}

.modalidades-titulo {
display: flex;
align-items: center;
gap: 18px;
z-index: 1;
}

.modalidades-titulo-icon {
width: 50px;
height: 50px;
color: var(–dorado-claro);
flex-shrink: 0;
}

.modalidades-titulo-text {
font-size: 14px;
letter-spacing: 3px;
text-transform: uppercase;
font-weight: 500;
line-height: 1.4;
}

.modalidad-item {
display: flex;
align-items: center;
gap: 16px;
z-index: 1;
}

.modalidad-icon {
width: 40px;
height: 40px;
color: var(–hueso);
opacity: 0.9;
flex-shrink: 0;
}

.modalidad-text {
font-size: 14px;
line-height: 1.4;
}

.modalidad-text strong {
font-weight: 500;
display: block;
margin-bottom: 4px;
}

.modalidad-text span {
font-size: 12px;
opacity: 0.85;
}

/* ============ TESTIMONIOS ============ */
.testimonios {
padding: 120px 60px;
background: var(–crema);
}

.testimonios-grid {
max-width: 1100px;
margin: 0 auto;
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 40px;
}

.testimonio {
background: var(–hueso);
padding: 40px 36px;
border-radius: 12px;
border: 1px solid var(–linea);
position: relative;
}

.testimonio-icon {
color: var(–dorado);
font-family: ‘Cormorant Garamond’, serif;
font-size: 60px;
line-height: 0.6;
margin-bottom: 16px;
display: block;
}

.testimonio-quote {
font-family: ‘Cormorant Garamond’, serif;
font-size: 22px;
line-height: 1.4;
font-style: italic;
color: var(–azul-deep);
margin-bottom: 28px;
font-weight: 400;
}

.testimonio-autor {
font-size: 12px;
letter-spacing: 2px;
text-transform: uppercase;
color: var(–texto-suave);
padding-top: 20px;
border-top: 1px solid var(–linea);
}

/* ============ CONTACTO ============ */
.contacto {
padding: 120px 60px;
background: linear-gradient(180deg, var(–hueso) 0%, var(–crema) 100%);
position: relative;
}

.contacto-container {
max-width: 700px;
margin: 0 auto;
text-align: center;
}

.contacto-title {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(36px, 4.5vw, 56px);
font-weight: 400;
color: var(–azul-deep);
line-height: 1.15;
margin: 24px 0 20px;
letter-spacing: -0.5px;
}

.contacto-title em { font-style: italic; color: var(–azul-dark); }

.contacto-desc {
font-size: 17px;
line-height: 1.7;
color: var(–texto-suave);
margin-bottom: 50px;
max-width: 500px;
margin-left: auto;
margin-right: auto;
}

.form-row {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 24px;
margin-bottom: 24px;
}

.form-field {
text-align: left;
}

.form-field label {
display: block;
font-size: 11px;
letter-spacing: 2px;
text-transform: uppercase;
color: var(–texto-suave);
margin-bottom: 10px;
}

.form-field input,
.form-field textarea {
width: 100%;
background: var(–hueso);
border: 1px solid var(–linea);
padding: 14px 16px;
font-family: ‘Inter’, sans-serif;
font-size: 15px;
color: var(–azul-deep);
transition: all 0.3s;
font-weight: 300;
border-radius: 6px;
}

.form-field input:focus,
.form-field textarea:focus {
outline: none;
border-color: var(–dorado);
background: var(–hueso);
}

.form-field textarea {
resize: vertical;
min-height: 120px;
margin-bottom: 30px;
font-family: ‘Inter’, sans-serif;
}

.contacto-footer-text {
margin-top: 60px;
font-family: ‘Allura’, cursive;
font-size: 36px;
color: var(–azul-dark);
line-height: 1;
}

/* ============ FOOTER ============ */
footer {
background: var(–azul-deep);
color: rgba(250, 249, 246, 0.7);
padding: 70px 60px 30px;
}

.footer-grid {
max-width: 1200px;
margin: 0 auto;
display: grid;
grid-template-columns: 1.5fr 1fr 1fr 1fr;
gap: 50px;
margin-bottom: 50px;
}

.footer-logo {
font-family: ‘Cormorant Garamond’, serif;
font-size: 28px;
color: var(–hueso);
margin-bottom: 14px;
letter-spacing: 4px;
}

.footer-tagline {
font-family: ‘Allura’, cursive;
font-size: 28px;
color: var(–dorado-claro);
margin-bottom: 20px;
line-height: 1;
}

.footer-desc {
font-size: 13px;
line-height: 1.7;
max-width: 280px;
}

.footer-col h4 {
color: var(–hueso);
font-size: 11px;
letter-spacing: 3px;
text-transform: uppercase;
margin-bottom: 18px;
font-weight: 500;
}

.footer-col ul {
list-style: none;
}

.footer-col li {
margin-bottom: 10px;
}

.footer-col a {
color: rgba(250, 249, 246, 0.65);
text-decoration: none;
font-size: 13px;
transition: color 0.3s;
}

.footer-col a:hover { color: var(–dorado-claro); }

.footer-social {
display: flex;
gap: 14px;
margin-top: 16px;
}

.footer-social a {
width: 36px;
height: 36px;
border: 1px solid rgba(250, 249, 246, 0.2);
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
transition: all 0.3s;
}

.footer-social a:hover {
border-color: var(–dorado-claro);
